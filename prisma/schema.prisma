generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  status       String   @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InfluencerProfile {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  whatsapp       String
  country        String
  city           String?
  primaryNetwork String
  socialHandle   String
  audienceSize   Int?
  categories     String
  languages      String
  motivation     String?
  status         String   @default("PENDING")
  referralSlug   String   @unique
  referralCode   String   @unique
  availableCents Int      @default(0)
  pendingCents   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  earnings   Earning[]
  events     ReferralEvent[]
  invites    InfluencerInvite[]    @relation("Inviter")
  loginCodes InfluencerLoginCode[]
}

model InfluencerLoginCode {
  id           String    @id @default(cuid())
  influencerId String
  email        String
  codeHash     String
  attempts     Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([influencerId, createdAt])
}

model Campaign {
  id           String   @id @default(cuid())
  title        String
  description  String
  objective    String
  rewardCents  Int
  currency     String   @default("EUR")
  startsAt     DateTime @default(now())
  endsAt       DateTime?
  status       String   @default("ACTIVE")
  materialType String
  createdAt    DateTime @default(now())

  earnings Earning[]
}

model ContentAsset {
  id          String   @id @default(cuid())
  title       String
  type        String
  description String
  url         String
  createdAt   DateTime @default(now())
}

model HomeLink {
  id           String   @id @default(cuid())
  title        String
  subtitle     String
  titlePtPt    String?
  subtitlePtPt String?
  titleEn      String?
  subtitleEn   String?
  titleEs      String?
  subtitleEs   String?
  titleFr      String?
  subtitleFr   String?
  href         String
  icon         String
  tone         String   @default("blue")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReferralEvent {
  id           String   @id @default(cuid())
  influencerId String
  type         String
  value        Int      @default(1)
  source       String?
  metadata     String?
  createdAt    DateTime @default(now())

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
}

model Earning {
  id           String   @id @default(cuid())
  influencerId String
  campaignId   String?
  amountCents  Int
  currency     String   @default("EUR")
  status       String   @default("PENDING")
  description  String
  createdAt    DateTime @default(now())

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model InfluencerInvite {
  id           String   @id @default(cuid())
  influencerId String
  inviteeName  String
  inviteeEmail String
  status       String   @default("INVITED")
  bonusCents   Int      @default(0)
  createdAt    DateTime @default(now())

  influencer InfluencerProfile @relation("Inviter", fields: [influencerId], references: [id], onDelete: Cascade)
}

model MeetingSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking PartnershipMeeting?

  @@unique([startsAt, endsAt])
  @@index([startsAt])
  @@index([isActive, startsAt])
}

model PartnershipMeeting {
  id        String   @id @default(cuid())
  slotId    String   @unique
  name      String
  email     String
  whatsapp  String
  country   String
  company   String?
  message   String?
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot MeetingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([status, createdAt])
}
